{
  "name": "meshstage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MeshStage — mobile-first 3D character animation & real-time lip-sync creation studio.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "server": "node server/index.mjs",
    "build:deploy": "VITE_MESHSTAGE_API=/api npm run build",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "build:pages": "vite build --base=/MeshStage/"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.116.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
