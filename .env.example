# --- TTS / conversion service (optional) -------------------------------------
# Base URL of the MeshStage service (see server/). Unset, the studio falls back
# to device voices and a localStorage library.
VITE_MESHSTAGE_API=http://localhost:8787

# --- Accounts and render credits (optional) ---------------------------------
# A Supabase project with supabase/migrations applied. Unset, the studio runs
# its local demo tier instead and no sign-in is required.
#
# The anon/publishable key is designed to ship in the bundle: it grants nothing
# on its own. Row-level security is what protects the data, and credits can
# only be spent through a balance-checked database function.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
