# --- TTS / conversion service (optional) -------------------------------------
# Base URL of the MeshStage service (see server/). Unset, the studio falls back
# to device voices and a localStorage library.
VITE_MESHSTAGE_API=http://localhost:8787

# --- Accounts and render credits (optional) ---------------------------------
# A Supabase project with supabase/migrations applied. Unset, the studio runs
# its local demo tier instead and no sign-in is required.
#
# The anon/publishable key is designed to ship in the bundle: it grants nothing
# on its own. Row-level security is what protects the data, and credits can
# only be spent through a balance-checked database function.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Image-to-3D reconstruction (optional) -----------------------------------
# Base URL of a service that turns an uploaded image into real 3D geometry
# (see server/providers/reconstruct.mjs — Meshy, Tripo and fal are wired up).
# Unset, generation stays fully local: the studio reads the upload's pixels and
# builds a procedural rig that matches its colours, proportions and subject.
#
# Note that image-to-3D services return *geometry*, not a rig. Unless the
# provider also runs a rigging pass, the returned mesh has no blendshapes and
# lip-sync will not move it — the studio says so on screen rather than
# pretending otherwise.
VITE_MESHSTAGE_GEN_API=http://localhost:8787
